# Bandit configuration for security scanning
# https://bandit.readthedocs.io/

exclude_dirs:
  - '/tests/'
  - '/test/'
  - '/.venv/'
  - '/venv/'

# Tests to run
tests:
  - B101  # assert_used
  - B102  # exec_used
  - B103  # set_bad_file_permissions
  - B104  # hardcoded_bind_all_interfaces
  - B105  # hardcoded_password_string
  - B106  # hardcoded_password_funcarg
  - B107  # hardcoded_password_default
  - B108  # hardcoded_tmp_directory
  - B110  # try_except_pass
  - B112  # try_except_continue
  - B201  # flask_debug_true
  - B301  # pickle
  - B302  # marshal
  - B303  # md5
  - B304  # des
  - B305  # cipher
  - B306  # mktemp_q
  - B307  # eval
  - B308  # mark_safe
  - B309  # httpsconnection
  - B310  # urllib_urlopen
  - B311  # random
  - B312  # telnetlib
  - B313  # xml_bad_etree
  - B314  # xml_bad_pulldom
  - B315  # xml_bad_sax
  - B316  # xml_bad_expat
  - B317  # xml_bad_etree_iterparse
  - B318  # xml_bad_etree_elementtree
  - B319  # xml_bad_etree_cElementTree
  - B320  # xml_bad_etree_cElementTree
  - B321  # ftplib
  - B322  # unverified_context
  - B323  # unverified_context
  - B324  # hashlib
  - B325  # tempnam

# Skip files matching these patterns
skips:
  - B101  # Assertions in tests are OK
