DJANGO_SECRET_KEY=replace-with-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.0.5,windows-server-vm
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://10.0.0.5:5173

# PostgreSQL (VM test configuration)
POSTGRES_DB=asset_buddy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Use PostgreSQL for the VM test
USE_SQLITE=0

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://10.0.0.5
